[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and find your files, and search in plain words
Exec=/usr/bin/halos-files %U
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
Keywords=files;folders;explorer;browse;search;documents;
StartupWMClass=halos-files
