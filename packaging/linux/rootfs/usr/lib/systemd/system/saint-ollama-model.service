# Sets up SAINT's local AI once for this PC's hardware, at the lowest CPU and disk priority, retrying until it has a
# network. device-setup (core/provision.py) picks the tier (core/device_profile.py), installs CUDA on NVIDIA PCs and
# downloads the Whisper model; ollama-model then pulls that tier's Ollama model (or, without a profile, the one named
# in /etc/halo/ollama-model: HALO_OLLAMA_MODEL, llama3.1:8b, ~5 GB; the small HALO_OLLAMA_SMALL_MODEL on PCs with
# < 12 GB RAM and no NVIDIA GPU). Not in the live session (it would fill the RAM overlay); done once, then never again
# (the marker file names the model pulled). SAINT shows the progress (core/model_pull.py follows the same pull through
# Ollama's API) and copies the choices into the user's config unless they changed them.
[Unit]
Description=SAINT: set up the local AI for this PC (CUDA, Whisper, Ollama model)
Wants=ollama.service
After=ollama.service network.target halo-gpu-detect.service
ConditionKernelCommandLine=!archisobasedir
ConditionPathExists=!/var/lib/ollama/.saint-model-ready

[Service]
Type=oneshot
EnvironmentFile=-/etc/halo/ollama-model
ExecStartPre=/usr/libexec/saintos/device-setup
ExecStart=/usr/libexec/saintos/ollama-model auto
Restart=on-failure
RestartSec=120
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

[Install]
WantedBy=multi-user.target
