#!/usr/bin/bash
# Meta+N: a note for SAINT about what to fix or add in HalOS (ui/note_popup.py: drag over it, saved in SAINT Vault/Fix).
set -euo pipefail
PY=/opt/saint/venv/bin/python
[ -x "$PY" ] || { echo "SAINT isn't installed correctly: $PY is missing." >&2; exit 1; }
cd /opt/saint/app
exec "$PY" -m ui.note_popup "${@:---region}"
