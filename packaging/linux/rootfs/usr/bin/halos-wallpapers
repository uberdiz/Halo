#!/usr/bin/bash
# HalOS Wallpapers: SAINT's living wallpaper, Wallpaper Engine wallpapers (HalOS and Windows Steam) and pictures.
set -euo pipefail
PY=/opt/saint/venv/bin/python
[ -x "$PY" ] || { echo "SAINT isn't installed correctly: $PY is missing." >&2; exit 1; }
cd /opt/saint/app
exec "$PY" -m ui.wallpapers_app "$@"
