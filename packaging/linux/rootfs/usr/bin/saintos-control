#!/usr/bin/bash
# The SAINTOS Control Center is now SAINT's Halo page (one SAINT app). Kept so old shortcuts and
# muscle memory still work:  saintos-control [--welcome] [--page NAME]
set -euo pipefail
page=Welcome
while [ $# -gt 0 ]; do
  case "$1" in
    --welcome) page=Welcome; shift ;;
    --page) page="${2:-Welcome}"; shift 2 ;;
    *) shift ;;
  esac
done
case "$page" in [Aa]pps|[Ss]tore) exec /usr/bin/saint-store ;; esac
exec /usr/bin/saint --page "$page"
