#!/usr/bin/bash
# SAINT on SAINTOS: the system install in /opt/saint (app + its own Python environment).
# Data lives in ~/.local/share/SAINT (core/paths.py: system_install()).
#   saint                  open SAINT
#   saint --background     start in the tray
#   saint --selftest FILE  check the install without starting it
set -euo pipefail
APP=/opt/saint/app
PY=/opt/saint/venv/bin/python
if [ ! -x "$PY" ]; then
  echo "SAINT isn't installed correctly: $PY is missing. Run saintos-diagnose." >&2
  exit 1
fi
# CUDA 12 for Whisper, installed at first boot on NVIDIA PCs (core/provision.py; absent everywhere else).
if [ -r /var/lib/saint/gpu/env ]; then . /var/lib/saint/gpu/env; fi
cd "$APP"
exec "$PY" app.py "$@"
