# Halo live/installer image: Arch base + a lean KDE Plasma 6 + SAINT. One package per line.
# Lean on purpose (plan.md: smaller and faster than Windows): plasma-desktop and the pieces a desktop
# needs, not plasma-meta; only the apps Halo ships by default; laptop/desktop firmware, not server NICs.

# Base system and live boot
base
linux
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
syslinux
sudo
nano
zram-generator
power-profiles-daemon

# Firmware for PCs and laptops (GPUs, Wi-Fi, Bluetooth, audio); server network cards left out
linux-firmware-amdgpu
linux-firmware-radeon
linux-firmware-intel
linux-firmware-nvidia
linux-firmware-realtek
linux-firmware-atheros
linux-firmware-mediatek
linux-firmware-broadcom
linux-firmware-cirrus
linux-firmware-other
sof-firmware

# Disks and file systems (the installer and dual boot)
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
rsync
gptfdisk
parted
udisks2

# Boot loader for installed systems (Calamares) and dual boot detection
grub
efibootmgr
os-prober

# Secure Boot: Microsoft-signed shim, signing tools, MOK enrollment
shim-signed
sbsigntools
mokutil

# Snapshots (SAINT's Recovery page): one before and after every package change, bootable from GRUB
snapper
snap-pac
grub-btrfs
inotify-tools

# Desktop: KDE Plasma 6 on Wayland, the parts a desktop needs
plasma-desktop
plasma-nm
plasma-pa
bluedevil
powerdevil
kscreen
kwallet-pam
ksshaskpass
breeze-gtk
kde-gtk-config
xdg-desktop-portal-kde
layer-shell-qt
qt6-websockets

# Phone link (KDE Connect: Android, and the iOS app) and remote desktop from a phone (Plasma's RDP server)
kdeconnect
krdp
sddm
sddm-kcm
plymouth

# NVIDIA (RTX 50 Blackwell needs it): nvidia-open loads only on PCs whose NVIDIA GPU it drives and
# nouveau is blacklisted only then (halo-system: halo-gpu-detect.service). lib32 for Steam/Wine ([multilib]).
nvidia-open
nvidia-utils
lib32-nvidia-utils
nvidia-settings

# Apps (pinned on the taskbar: Firefox, Dolphin, Konsole, SAINT, VS Code, Spotify; Spotify comes from
# Flathub on first boot, halo-system: halo-flatpak-apps.service)
firefox
dolphin
konsole
code
kate
spectacle
ark
xdg-user-dirs

# Fonts: Noto for text, Noto Color Emoji (Apple-style emoji is an optional download in SAINT)
noto-fonts
noto-fonts-emoji

# Audio, network, Bluetooth
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
networkmanager
bluez
bluez-utils

# Apps from the AUR and Flathub; local AI
base-devel
git
flatpak
# SAINT Store's list of Arch apps, with their icons and screenshots (core/store_art.py)
appstream
archlinux-appstream-data
# The CPU build (20 MB). NVIDIA PCs get ollama-cuda + cuda (3 GB) at first boot: core/provision.py.
ollama
paru-bin

# Claude Code CLI (SAINT's Evolve / OS Expansion Agent runs it with the user's own account): AUR claude-code,
# built into [halo] by build_iso.sh
nodejs
npm
claude-code

# VirtualBox guest services: enabled, but only start inside VirtualBox (vboxservice.service.d/halo.conf)
virtualbox-guest-utils

# Halo ([halo] repo, built by build_iso.sh)
saint
halo-branding
halo-system
calamares
halo-calamares-config
