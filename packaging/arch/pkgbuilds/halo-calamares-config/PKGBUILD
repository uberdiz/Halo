# Calamares configuration for installing Halo from the live ISO: Btrfs with snapshot-ready subvolumes,
# GRUB with os-prober (dual boot), and a cleanup step that turns the live image into a normal system.
pkgname=halo-calamares-config
pkgver=0.0.0
pkgrel=1
pkgdesc="Halo installer configuration for Calamares"
arch=(any)
url="https://github.com/IONX-Studios/SAINT"
license=(LicenseRef-SAINT)
depends=(calamares halo-branding shim-signed sbsigntools mokutil)
source=(calamares.tar halo-cleanup halo-secureboot install-halo.desktop install-halo halotarget.desc halotarget.py)
noextract=(calamares.tar)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  install -d "$pkgdir/etc/calamares"
  tar -xf "$srcdir/calamares.tar" -C "$pkgdir/etc/calamares"
  install -Dm0755 "$srcdir/halo-cleanup" "$pkgdir/usr/lib/halo/calamares-cleanup"
  install -Dm0755 "$srcdir/halo-secureboot" "$pkgdir/usr/lib/halo/calamares-secureboot"
  install -Dm0644 "$srcdir/install-halo.desktop" "$pkgdir/usr/share/applications/install-halo.desktop"
  install -Dm0755 "$srcdir/install-halo" "$pkgdir/usr/lib/halo/install-halo"
  # makepkg only takes local sources from the PKGBUILD's own folder, hence the flat names here.
  install -Dm0644 "$srcdir/halotarget.desc" "$pkgdir/usr/lib/halo/calamares-modules/halotarget/module.desc"
  install -Dm0644 "$srcdir/halotarget.py" "$pkgdir/usr/lib/halo/calamares-modules/halotarget/main.py"
}
