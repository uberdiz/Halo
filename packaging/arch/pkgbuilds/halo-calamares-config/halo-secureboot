#!/usr/bin/bash
# Last installer step (Calamares shellprocess@halo-secureboot, after the boot loader is installed).
#
# Secure Boot on the installed system:
#   firmware -> shim (signed by Microsoft) -> GRUB and the kernel, signed with this PC's own key (MOK).
# The key is made here, for this PC only, and never leaves it (/etc/secureboot/halo, root-only).
# A pacman hook signs every new kernel. On the first restart shim's MokManager asks once to enroll the
# key: Enroll MOK -> Continue -> Yes -> password "halo".
#
# Then the live ISO's tools are removed (this script's own package last).
set -u
log() { echo "halo-secureboot: $*"; }
SHIM=/usr/share/shim-signed
ESP=/boot/efi
ESP_NEEDS_MB=20
K=/etc/secureboot/halo
# GRUB with everything it needs built in: under shim it may not load modules from disk.
MODULES="all_video boot btrfs cat chain configfile echo efifwsetup efinet ext2 fat font gettext gfxmenu gfxterm
gfxterm_background gzio halt help iso9660 jpeg keystatus loadenv loopback linux ls lsefi lsefimmap lsefisystab
memdisk minicmd normal ntfs part_apple part_msdos part_gpt password_pbkdf2 png probe reboot regexp search
search_fs_uuid search_fs_file search_label serial sleep smbios squash4 test tpm true video xfs cryptodisk luks
luks2 lvm mdraid09 mdraid1x"

sign() { sbsign --key "$K/MOK.key" --cert "$K/MOK.crt" --output "$1" "$1" >/dev/null; }

write_hook() {
  install -d /etc/pacman.d/hooks
  cat > /etc/pacman.d/hooks/95-halo-secureboot.hook <<'EOF'
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Signing the kernel for Secure Boot (Halo)...
When = PostTransaction
Exec = /usr/bin/sh -c 'for k in /boot/vmlinuz-*; do /usr/bin/sbsign --key /etc/secureboot/halo/MOK.key --cert /etc/secureboot/halo/MOK.crt --output "$k" "$k"; done'
Depends = sbsigntools
EOF
}

secure_boot() {
  [ -d /sys/firmware/efi ] || { log "BIOS boot: nothing to do"; return 0; }
  command -v sbsign >/dev/null && [ -s "$SHIM/shimx64.efi" ] || { log "shim or sbsigntools missing"; return 0; }
  mountpoint -q "$ESP" || { log "no EFI partition at $ESP"; return 0; }
  # Only boot loaders go on the EFI partition (kernels stay in /boot on the root file system): shim, MokManager
  # and GRUB twice (EFI/Halo and EFI/BOOT), ~15 MB, so a reused 100 MB Windows EFI partition is enough.
  local free_mb
  free_mb="$(df -Pm "$ESP" | awk 'NR==2 {print $4}')"
  if [ "${free_mb:-0}" -lt "$ESP_NEEDS_MB" ]; then
    log "only ${free_mb} MB free on the EFI partition (needs ${ESP_NEEDS_MB} MB): keeping the plain GRUB entry"
    return 0
  fi

  install -d -m 0700 "$K"
  if [ ! -s "$K/MOK.key" ]; then
    openssl req -newkey rsa:2048 -nodes -keyout "$K/MOK.key" -new -x509 -sha256 -days 36500 \
      -subj "/CN=Halo on $(cat /etc/hostname 2>/dev/null || echo this PC)/" -out "$K/MOK.crt" 2>/dev/null
    openssl x509 -outform DER -in "$K/MOK.crt" -out "$K/MOK.cer"
    chmod 0600 "$K/MOK.key"
  fi

  # shellcheck disable=SC2086
  grub-install --target=x86_64-efi --efi-directory="$ESP" --bootloader-id=Halo --modules="$(echo $MODULES)" \
    --sbat /usr/share/grub/sbat.csv --no-nvram >/dev/null 2>&1 || { log "grub-install for shim failed"; return 0; }
  local D="$ESP/EFI/Halo"
  sign "$D/grubx64.efi"
  # With Secure Boot on, the live system's key is already approved here: boot files signed with it need no second key.
  local signed=/var/lib/halo-signed-boot root_dev root_uuid use_signed=0
  root_dev="$(findmnt -no SOURCE / | sed 's/\[.*//')"
  root_uuid="$(blkid -s UUID -o value "$root_dev")"
  install -m 0644 "$SHIM/shimx64.efi" "$D/shimx64.efi"
  install -m 0644 "$SHIM/mmx64.efi" "$D/mmx64.efi"
  # The public half of this PC's key, for "Enroll key from disk" if the queued enrollment below is missed.
  # (HALO-MOK.cer on HALOLIVE is the live system's key: it can't start the installed HalOS.)
  install -m 0644 "$K/MOK.cer" "$D/HalOS-this-PC.cer"
  # The removable-media path too (some firmware only looks there), but never over another OS's fallback
  # loader: on an EFI partition shared with Windows, EFI/BOOT/BOOTX64.EFI stays Windows' own.
  if [ -e "$ESP/EFI/Microsoft/Boot/bootmgfw.efi" ] && [ -e "$ESP/EFI/BOOT/BOOTX64.EFI" ]      && ! grep -aq "UEFI SHIM" "$ESP/EFI/BOOT/BOOTX64.EFI"; then
    log "EFI partition shared with Windows: leaving EFI/BOOT/BOOTX64.EFI alone"
  else
    install -d "$ESP/EFI/BOOT"
    install -m 0644 "$SHIM/shimx64.efi" "$ESP/EFI/BOOT/BOOTX64.EFI"
    install -m 0644 "$SHIM/mmx64.efi" "$ESP/EFI/BOOT/mmx64.efi"
    install -m 0644 "$D/grubx64.efi" "$ESP/EFI/BOOT/grubx64.efi"
  fi
  for k in /boot/vmlinuz-*; do [ -f "$k" ] && sign "$k"; done
  if [ -n "$root_uuid" ] && /usr/lib/halo/signed-boot / "$ESP" "$signed" "$root_uuid"; then
    use_signed=1
    log "boot files signed with the live key: no key screen at first start"
  else
    log "signed boot files not used: keeping this PC's own key"
  fi
  rm -rf "$signed"

  # Boot entry: firmware -> shim (replaces the plain GRUB entry the installer made).
  local dev disk part
  dev="$(findmnt -no SOURCE "$ESP")"
  disk="/dev/$(lsblk -no PKNAME "$dev" | head -n1)"
  part="$(cat "/sys/class/block/$(basename "$dev")/partition" 2>/dev/null)"
  if [ -n "$part" ] && [ -b "$disk" ]; then
    efibootmgr | sed -n 's/^Boot\([0-9A-F]\{4\}\)\*\? Halo\b.*/\1/p' | while read -r n; do efibootmgr -q -b "$n" -B; done
    efibootmgr -q --create --disk "$disk" --part "$part" --label "HalOS" --loader '\EFI\Halo\shimx64.efi' \
      || log "couldn't add the boot entry"
  fi

  write_hook

  # shim drops the queued key if its 10-second prompt runs out, so the prompt waits (--timeout -1).
  # Ask shim to enroll the key on the next start (one-time password "halo", typed in MokManager), but only when
  # Secure Boot is on: with it off, the key does nothing, and that blue screen and its password would be a surprise.
  if [ "$use_signed" = 1 ]; then
    log "no key enrollment needed"
  elif ! mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'; then
    log "Secure Boot is off: no key enrollment on first start"
  elif command -v mokutil >/dev/null; then
    printf 'halo\nhalo\n' | mokutil --import "$K/MOK.cer" >/dev/null 2>&1 \
      && { mokutil --timeout -1 >/dev/null 2>&1 || log "couldn't remove MokManager's 10-second limit"
           log "key queued: on restart choose Enroll MOK -> Continue -> Yes, password: halo"; } \
      || log "mokutil couldn't queue the key (Secure Boot can still be turned off in the firmware)"
  fi
}

secure_boot

grep -qi windows /boot/grub/grub.cfg 2>/dev/null && log "GRUB lists Windows" \
  || log "GRUB has no Windows entry (os-prober found none); the PC's boot menu and SAINT's Restart into Windows still work"

# Windows stays the default while HalOS is new (after the HalOS entry above is (re)created, which puts it first).
/usr/lib/halo/calamares-bootorder || log "boot order not changed"

# The live ISO's tools, last (this removes the package this script came from; it keeps running).
pacman -Rns --noconfirm mkinitcpio-archiso halo-calamares-config calamares >/dev/null 2>&1 \
  || log "removing live packages failed"
exit 0
