#!/usr/bin/bash
# Runs inside the newly installed system (Calamares shellprocess@halo-cleanup, before initcpio and
# the boot loader): removes what only the live ISO needs and gives the system Arch's normal setup.
set -u
log() { echo "halo-cleanup: $*"; }

# Live-only units and files from the image (they're inert outside the live ISO, but don't belong here).
for u in halo-live.service halo-pacman-init.service; do
  systemctl disable "$u" 2>/dev/null
  rm -f "/etc/systemd/system/$u"
done
rm -rf /usr/local/lib/halo
rm -f /etc/mkinitcpio.conf.d/halo-live.conf

# Fast boot: a small initramfs (only this PC's modules, "autodetect") that unpacks quickly (zstd at a low level).
# Calamares's initcpio step, which runs next, builds it with these settings.
mkdir -p /etc/mkinitcpio.conf.d
cat > /etc/mkinitcpio.conf.d/10-halo-fastboot.conf <<'EOF'
# HalOS: zstd unpacks faster than xz/gzip at boot; -3 keeps the build quick on every kernel update.
COMPRESSION="zstd"
COMPRESSION_OPTIONS=(-3)
MODULES_DECOMPRESS="no"
EOF

# Arch's default kernel preset (the image had an archiso-only one).
cat > /etc/mkinitcpio.d/linux.preset <<'EOF'
# mkinitcpio preset file for the 'linux' package

ALL_kver="/boot/vmlinuz-linux"

PRESETS=('default' 'fallback')

default_image="/boot/initramfs-linux.img"

fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

# A working mirror and the installed system's own pacman keyring.
grep -q '^Server' /etc/pacman.d/mirrorlist 2>/dev/null \
  || printf 'Server = %s/$repo/os/$arch\n' https://geo.mirror.pkgbuild.com https://mirror.rackspace.com/archlinux \
       https://mirrors.kernel.org/archlinux >> /etc/pacman.d/mirrorlist   # fallbacks when one is down
pacman-key --init >/dev/null 2>&1 && pacman-key --populate archlinux >/dev/null 2>&1 || log "pacman keyring setup failed"

# Snapshots for SAINT's Recovery page: snapper on the Btrfs root, using the @snapshots subvolume the
# installer mounted at /.snapshots; snap-pac snapshots every package change, grub-btrfs lists them in GRUB.
if [ "$(findmnt -no FSTYPE /)" = btrfs ] && command -v snapper >/dev/null; then
  umount /.snapshots 2>/dev/null
  rm -rf /.snapshots
  if snapper --no-dbus -c root create-config /; then
    btrfs subvolume delete /.snapshots >/dev/null 2>&1
    mkdir -p /.snapshots
    mount /.snapshots 2>/dev/null || log "couldn't mount @snapshots"
    chmod 750 /.snapshots
    sed -i -e 's/^ALLOW_GROUPS=.*/ALLOW_GROUPS="wheel"/' -e 's/^SYNC_ACL=.*/SYNC_ACL="yes"/' \
           -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="20"/' \
           /etc/snapper/configs/root
    systemctl enable snapper-cleanup.timer grub-btrfsd.service 2>/dev/null
  else
    log "snapper setup failed; snapshots stay off"
  fi
fi

# The live ISO's tools are removed at the very end (halo-secureboot), after the boot loader is set up.
exit 0
