# SAINT for Halo: the app in /opt/saint/app with its own Python 3.12 (python-build-standalone via uv)
# and venv, so SAINT keeps the Python and package set its tests run on, whatever Arch's python is.
# Built by packaging/arch/build_iso.sh, which stages saint-src.tar (git archive of the built commit)
# and sets pkgver from packaging/arch/VERSION.
pkgname=saint
pkgver=0.0.0
pkgrel=1
pkgdesc="SAINT, Halo's local voice-first desktop assistant"
arch=(x86_64)
url="https://github.com/IONX-Studios/SAINT"
license=(LicenseRef-SAINT)
depends=(portaudio espeak-ng libxkbcommon xcb-util-cursor qt6-tools qt6-websockets wl-clipboard playerctl libnotify
         xdg-utils tesseract tesseract-data-eng pciutils
         # Halo Remote host (modules/remote_desktop): runs on Arch's python with GStreamer WebRTC, not in the venv
         python python-gobject gst-python python-cryptography python-keyring libsoup3 libnice kdialog
         gst-plugins-base gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-plugin-pipewire)
makedepends=(uv)
backup=(etc/halo/ollama-model)
options=(!strip !debug !lto)
_spacy_model=en_core_web_sm-3.8.0-py3-none-any.whl
# Kokoro-82M for onnxruntime: SAINT's voice ships in the image, so the first words are Kokoro's and never a
# fallback voice while a 350 MB download runs (modules/voice/kokoro_onnx.py reads app/data/tts/kokoro-onnx).
_kokoro=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0
source=(saint-src.tar
        saint-runtime.lock
        "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/$_spacy_model"
        "$_kokoro/kokoro-v1.0.onnx"
        "$_kokoro/voices-v1.0.bin")
noextract=(saint-src.tar "$_spacy_model" kokoro-v1.0.onnx voices-v1.0.bin)
sha256sums=(SKIP
            SKIP
            1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f7c1a0fb85
            7d5df8ecf7d4b1878015a32686053fd0eebe2bc377234608764cc0ef3636a6c5
            bca610b8308e8d99f32e6fe4197e7ec01679264efed0cac9140fe9c29f1fbf7d)

# build_iso.sh points these at caches in its workdir, so a rebuild doesn't download ~1 GB again.
_uv_env() {
  export UV_PYTHON_INSTALL_DIR="${HALO_UV_PYTHON_DIR:-$srcdir/python-dist}"
  export UV_CACHE_DIR="${UV_CACHE_DIR:-$srcdir/uv-cache}" UV_PYTHON_PREFERENCE=only-managed
}

_python() {   # the uv-managed CPython 3.12 (installed by build())
  _uv_env
  readlink -f "$(uv python find 3.12)"
}

prepare() {
  rm -rf app && mkdir app
  tar -xf saint-src.tar -C app
}

build() {
  _uv_env
  uv python install 3.12
  "$(_python)" --version
}

package() {
  local root="$pkgdir/opt/saint" py home
  py="$(_python)"
  home="$(dirname "$(dirname "$py")")"
  install -d "$root"
  cp -a "$home" "$root/python"
  rm -f "$root/python/lib/python3.12/EXTERNALLY-MANAGED"

  # The venv, installed exactly from the lock (no resolution; en_core_web_sm from the pinned wheel).
  "$root/python/bin/python3.12" -m venv --without-pip "$root/venv"
  _uv_env
  uv pip install --link-mode=copy --python "$root/venv/bin/python" --no-deps --find-links "$srcdir" -r "$srcdir/saint-runtime.lock"
  cp -a "$srcdir/app" "$root/app"
  install -Dm0644 -t "$root/app/data/tts/kokoro-onnx" "$srcdir/kokoro-v1.0.onnx" "$srcdir/voices-v1.0.bin"

  # The package fails here, not on someone's desktop, if SAINT's runtime doesn't import.
  (cd "$root/app" && QT_QPA_PLATFORM=offscreen "$root/venv/bin/python" - <<'PY'
import importlib, sys
mods = ["PySide6.QtWidgets", "PySide6.QtSvg", "numpy", "requests", "psutil", "sounddevice", "soundfile",
        "onnxruntime", "faster_whisper", "kokoro_onnx", "misaki.en", "en_core_web_sm", "keyring", "secretstorage",
        "jeepney", "segno", "zeroconf", "cryptography", "PIL", "core.paths", "core.platform_caps", "core.saintos_apps",
        "modules.desktop.linux.kwin", "ui.saintos_center", "ui.taskmanager", "core.sysinfo",
        "core.kde_desktop", "core.window_anim", "core.startup_apps", "ui.supernova"]
bad = []
for m in mods:
    try:
        importlib.import_module(m)
    except Exception as e:
        bad.append(f"{m}: {type(e).__name__}: {e}")
if bad:
    sys.exit("SAINT runtime imports failed:\n  " + "\n  ".join(bad))
print("SAINT runtime imports OK")
# Kokoro must really speak from the packaged files, not just import.
from modules.voice import kokoro_onnx
assert kokoro_onnx.available(), f"Kokoro files missing in {kokoro_onnx.model_dir()}"
from core.voice_check import test_kokoro
res = test_kokoro(play=False, download=False)
if not res["ok"]:
    sys.exit("Kokoro synthesis failed: " + res["detail"])
print("Kokoro OK:", res["detail"])
PY
  )

  # Byte-compile once (/opt is read-only at run time); recorded paths are the installed ones.
  "$root/venv/bin/python" -m compileall -q -j0 -s "$pkgdir" -p / \
    "$root/app" "$root/venv/lib/python3.12/site-packages" >/dev/null || true

  # Relocate: the venv was made in $pkgdir; point it at /opt/saint/python.
  local f
  for f in python python3 python3.12; do
    ln -sfn /opt/saint/python/bin/python3.12 "$root/venv/bin/$f"
  done
  sed -i "s#$pkgdir##g" "$root/venv/pyvenv.cfg"
  grep -rlI --null "$pkgdir" "$root/venv/bin" | xargs -0 -r sed -i "s#$pkgdir##g"
  if grep -rqI "$pkgdir" "$root/venv/bin" "$root/venv/pyvenv.cfg"; then
    echo "the venv still points into \$pkgdir" >&2
    return 1
  fi

  # Launchers, menu entries, services (shared with the Fedora image: packaging/linux/rootfs).
  local fs="$srcdir/app/packaging/linux/rootfs"
  install -Dm0755 -t "$pkgdir/usr/bin" "$fs"/usr/bin/{saint,saint-taskmgr,saint-store,saint-visual-shop,halos-files,saintos-control,saintos-apps,saintos-diagnose}
  install -Dm0644 -t "$pkgdir/usr/share/applications" "$fs"/usr/share/applications/*.desktop
  install -Dm0644 "$fs/usr/share/icons/hicolor/scalable/apps/saint-store.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/saint-store.svg"
  # SAINT's apps replace these: hidden, and redirected, if a dependency ever pulls them in.
  install -Dm0644 -t "$pkgdir/usr/local/share/applications" "$fs"/usr/local/share/applications/*.desktop
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/user" "$fs/usr/lib/systemd/user/saint.service"
  # Halo Remote host: installed, off until turned on in SAINT (Devices -> Remote desktop).
  sed 's#@SAINT_ROOT@#/opt/saint/app#g' "$srcdir/app/packaging/linux/systemd/halo-remote.service.in"     | install -Dm0644 /dev/stdin "$pkgdir/usr/lib/systemd/user/halo-remote.service"
  install -Dm0644 -t "$pkgdir/usr/lib/systemd/system" "$fs"/usr/lib/systemd/system/{saintos-boot-report,saint-ollama-model}.service
  install -Dm0755 -t "$pkgdir/usr/libexec/saintos" "$fs"/usr/libexec/saintos/{boot-report,firstrun,ollama-model,device-setup}
  # Which Ollama model saint-ollama-model.service pulls (8B default, small fallback): one file to edit.
  # /var/lib/saint: the first-boot setup's results, read by every user's SAINT (core/provision.py).
  install -dm0755 "$pkgdir/var/lib/saint"
  install -Dm0644 "$fs/etc/halo/ollama-model" "$pkgdir/etc/halo/ollama-model"
  install -Dm0644 -t "$pkgdir/etc/xdg/autostart" "$fs/etc/xdg/autostart/saintos-firstrun.desktop"
  # Screenshots: saved to Pictures/Screenshots and copied at once, no editor window flashing up afterwards.
  install -Dm0644 "$fs/etc/xdg/spectaclerc" "$pkgdir/etc/xdg/spectaclerc"
  # HalOS Files opens folders (Dolphin stays installed).
  install -Dm0644 "$fs/etc/xdg/mimeapps.list" "$pkgdir/etc/xdg/mimeapps.list"
  # The HalOS icon theme (tools/icons/gen_halos_icons.py); app makers' logos fall through to Breeze.
  install -d "$pkgdir/usr/share/icons"
  cp -a "$fs/usr/share/icons/HalOS" "$pkgdir/usr/share/icons/HalOS"
  install -Dm0644 "$fs/usr/share/icons/HalOS-light/index.theme" "$pkgdir/usr/share/icons/HalOS-light/index.theme"
  ln -s ../HalOS/scalable "$pkgdir/usr/share/icons/HalOS-light/scalable"
  install -Dm0644 "$srcdir/app/packaging/linux/apps/catalog.json" "$pkgdir/usr/share/saintos/apps.json"
  install -Dm0644 "$srcdir/app/SAINT.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/saint.png"
  # Plasma integration: Alt+` (KGlobalAccel), and the KWin script that places the Halo and the overlay
  # on Wayland (the screen edge that opens SAINT is off until chosen in Control Center).
  install -Dm0644 -t "$pkgdir/usr/share/kglobalaccel" "$fs"/usr/share/kglobalaccel/{saint-overlay,saint-taskmgr}.desktop
  cp -a "$fs/usr/share/kwin" "$pkgdir/usr/share/kwin"
  # The SAINT wallpaper that reacts to SAINT's voice (follows ws://127.0.0.1:47811, core/state_socket.py).
  install -d "$pkgdir/usr/share/plasma/wallpapers"
  cp -a "$fs/usr/share/plasma/wallpapers/org.saintos.wallpaper" "$pkgdir/usr/share/plasma/wallpapers/"
  # Desktop widgets: SAINT, the Halo (movable, resizable ring) and SAINT Music (any MPRIS player).
  install -d "$pkgdir/usr/share/plasma/plasmoids"
  local w
  for w in plasmoids/org.saintos.saint plasmoids/org.saintos.halo plasmoids/org.saintos.music; do
    cp -a "$fs/usr/share/plasma/$w" "$pkgdir/usr/share/plasma/plasmoids/"
  done
  # Global shortcuts: Alt+` opens SAINT's overlay, Ctrl+Shift+Esc opens SAINT Task Manager. Plasma gives
  # Alt+` (and Meta+`) to KWin's "Walk Through Windows of Current Application"; KWin keeps Meta+` here.
  # KDE's shortcut service (inside KWin on Plasma 6) reads only the user's own kglobalshortcutsrc, not
  # /etc/xdg, so this goes in /etc/skel and every new user (live user, installer's user) starts with it.
  # KWin's default must be written exactly as KWin registers it (Alt+`\tMeta+`) or KDE resets the entry.
  # Verified in the Halo VM, build 8: both keys work after login with this file (HALOS_TEST_RESULTS.md).
  # Desktops: core/kde_desktop.py SHORTCUT_ENTRIES (a test keeps the two equal). Plasma's task manager gives up
  # Meta+1..4 so they can go to desktops 1..4; KWin's Ctrl+F1..F4 stay.
  install -Dm0644 /dev/stdin "$pkgdir/etc/skel/.config/kglobalshortcutsrc" <<'EOF'
[kwin]
Walk Through Windows of Current Application=Meta+`,Alt+`\tMeta+`,Walk Through Windows of Current Application
Switch One Desktop to the Left=Meta+Ctrl+Left,Meta+Ctrl+Left,Switch One Desktop to the Left
Switch One Desktop to the Right=Meta+Ctrl+Right,Meta+Ctrl+Right,Switch One Desktop to the Right
Switch to Desktop 1=Meta+1\tCtrl+F1,Ctrl+F1,Switch to Desktop 1
Switch to Desktop 2=Meta+2\tCtrl+F2,Ctrl+F2,Switch to Desktop 2
Switch to Desktop 3=Meta+3\tCtrl+F3,Ctrl+F3,Switch to Desktop 3
Switch to Desktop 4=Meta+4\tCtrl+F4,Ctrl+F4,Switch to Desktop 4

[plasmashell]
activate task manager entry 1=none,Meta+1,Activate Task Manager Entry 1
activate task manager entry 2=none,Meta+2,Activate Task Manager Entry 2
activate task manager entry 3=none,Meta+3,Activate Task Manager Entry 3
activate task manager entry 4=none,Meta+4,Activate Task Manager Entry 4

[services][saint-overlay.desktop]
_launch=Alt+`

[services][saint-taskmgr.desktop]
_launch=Ctrl+Shift+Esc
EOF
  # Fluid, not rigid: blur and background contrast behind panels, menus and KRunner, the Overview (Meta+W, 4-finger
  # swipe up) on, wobbly windows off, dimmed screen behind password prompts; windows have no frame lines
  # (BorderSize=None, still resizable at the edges), so the soft shadow (breezerc) is the edge. Open/close/minimise
  # animations stay saint-star's (core/window_anim.py). tests/test_halos_look.py checks these keys.
  install -Dm0644 /dev/stdin "$pkgdir/etc/xdg/kwinrc" <<'EOF'
[Plugins]
saint-shellEnabled=true
saint-starEnabled=true
scaleEnabled=false
blurEnabled=true
contrastEnabled=true
overviewEnabled=true
slidingpopupsEnabled=true
dimscreenEnabled=true
wobblywindowsEnabled=false

[Effect-blur]
BlurStrength=10
NoiseStrength=3

[org.kde.kdecoration2]
BorderSize=None
BorderSizeAuto=false

[Desktops]
Number=4
Rows=1

[MouseBindings]
CommandAllWheel=Previous/Next Desktop
EOF
}
