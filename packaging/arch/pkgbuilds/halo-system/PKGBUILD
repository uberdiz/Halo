# HalOS system defaults that aren't SAINT or artwork:
#   - NVIDIA: nvidia-open only on PCs whose NVIDIA GPU it drives, nouveau blacklisted only then
#     (gpu-detect at every boot, before udev), nvidia_drm modeset=1 fbdev=1 for Wayland, no nouveau
#     in the initramfs of PCs with an NVIDIA GPU
#   - Flathub apps HalOS comes with (Spotify, Obsidian): installed once in the background, with a taskbar
#     launcher that installs on first click until then
pkgname=halo-system
pkgver=0.0.0
pkgrel=1
pkgdesc="HalOS system defaults: NVIDIA driver selection, preinstalled Flathub apps"
arch=(any)
url="https://github.com/IONX-Studios/SAINT"
license=(LicenseRef-SAINT)
depends=(flatpak kmod mkinitcpio efibootmgr polkit udisks2 ntfs-3g gptfdisk util-linux dosfstools btrfs-progs)
optdepends=('nvidia-open: NVIDIA driver for Turing and newer GPUs'
            'nvidia-utils: NVIDIA user-space driver'
            'hivex: read Windows registry values during migration (installed apps, time zone)')
backup=(etc/halo/flatpak-apps)
source=(gpu-detect halo-gpu-detect.service nvidia-utils.modprobe.conf zz-halo-gpu.mkinitcpio.conf
        flatpak-apps halo-flatpak-apps.service flatpak-apps.list com.spotify.Client.desktop md.obsidian.Obsidian.desktop
        halo-efiboot org.halos.efiboot.policy 50-halo-drives.rules halo-restart 42_halo_devices halo-update org.halos.update.policy)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

package() {
  install -Dm0755 "$srcdir/gpu-detect" "$pkgdir/usr/lib/halo/gpu-detect"
  install -Dm0644 "$srcdir/halo-gpu-detect.service" "$pkgdir/usr/lib/systemd/system/halo-gpu-detect.service"
  # Same name as nvidia-utils' file in /usr/lib/modprobe.d, so it replaces that one (which blacklists nouveau always).
  install -Dm0644 "$srcdir/nvidia-utils.modprobe.conf" "$pkgdir/etc/modprobe.d/nvidia-utils.conf"
  install -Dm0644 "$srcdir/zz-halo-gpu.mkinitcpio.conf" "$pkgdir/etc/mkinitcpio.conf.d/zz-halo-gpu.conf"

  install -Dm0755 "$srcdir/flatpak-apps" "$pkgdir/usr/lib/halo/flatpak-apps"
  install -Dm0644 "$srcdir/halo-flatpak-apps.service" "$pkgdir/usr/lib/systemd/system/halo-flatpak-apps.service"
  install -Dm0644 "$srcdir/flatpak-apps.list" "$pkgdir/etc/halo/flatpak-apps"
  install -Dm0644 "$srcdir/com.spotify.Client.desktop" "$pkgdir/usr/share/applications/com.spotify.Client.desktop"
  install -Dm0644 "$srcdir/md.obsidian.Obsidian.desktop" "$pkgdir/usr/share/applications/md.obsidian.Obsidian.desktop"
  # Both services are enabled in the image by build_iso.sh; installed systems are a copy of the image.

  # SAINT's Drives & OS: restart into another OS, mount internal drives (polkit rules, narrowly scoped).
  install -Dm0755 "$srcdir/halo-efiboot" "$pkgdir/usr/lib/halo/halo-efiboot"
  install -Dm0755 "$srcdir/halo-restart" "$pkgdir/usr/lib/halo/halo-restart"   # Recovery: restart with no dependencies
  install -Dm0644 "$srcdir/org.halos.efiboot.policy" "$pkgdir/usr/share/polkit-1/actions/org.halos.efiboot.policy"
  install -Dm0644 "$srcdir/50-halo-drives.rules" "$pkgdir/usr/share/polkit-1/rules.d/50-halo-drives.rules"
  # GRUB's "Start from another device" submenu (USB sticks, other disks, Microsoft boot manager, firmware setup).
  # Here and not in halo-calamares-config, which the installer removes: later grub-mkconfig runs keep it.
  install -Dm0755 "$srcdir/42_halo_devices" "$pkgdir/etc/grub.d/42_halo_devices"
  # SAINT's in-place updates (core/updater.py) and their rollback.
  install -Dm0755 "$srcdir/halo-update" "$pkgdir/usr/lib/halo/halo-update"
  install -Dm0644 "$srcdir/org.halos.update.policy" "$pkgdir/usr/share/polkit-1/actions/org.halos.update.policy"
}
